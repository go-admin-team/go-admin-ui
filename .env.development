# just a flag
ENV = 'development'

# base api
VUE_APP_BASE_API = 'http://localhost:8001'

# Suppress Sass deprecation warnings
SASS_SILENCE_DEPRECATIONS = 'legacy-js-api'

# Google Analytics measurement id (G-XXXXXXXXXX).
# Empty means the tag is not injected at all: no request to googletagmanager.com,
# nothing in the built index.html. Intranet and offline deployments need it that
# way, so it ships empty here -- the demo deployment sets it in build.yml.
VUE_APP_GA_ID = ''

# ICP filing number shown in the login footer. Left empty on purpose --
# a filing number belongs to whoever operates the deployment.
VUE_APP_ICP = ''
