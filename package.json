    "html-webpack-plugin": "4.5.2",
    "husky": "9.1.7",
    "jest": "27.5.1",
    "jest-serializer-vue": "^3.1.0",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "17.3.0",
