    "dropzone": "5.9.3",
    "echarts": "^5.5.0",
    "element-plus": "^2.8.0",
    "file-saver": "2.0.5",
    "fuse.js": "6.6.2",
    "js-cookie": "3.0.5",
    "jsonlint": "1.6.3",
    "jszip": "3.10.1",
    "moment": "^2.30.1",
    "normalize.css": "8.0.1",
    "nprogress": "0.2.0",
    "path-to-regexp": "6.3.0",
