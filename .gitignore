.DS_Store
node_modules/
dist/

# Synced application views -- what scripts/sync-apps.mjs writes.
# The single-level "*" (not "**") is what lets the negation below re-include
# one child; src/apps/_test-fixture is a committed test fixture, not build
# output, and the file itself says why.
src/apps/*
!src/apps/_test-fixture
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/*.log

tests/**/coverage/
tests/e2e/reports
selenium-debug.log

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.local

package-lock.json
yarn.lock

# Claude Code
CLAUDE.md
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/new-list-page/
